-- ---------- Tables ----------

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  username text unique not null,
  role text not null default 'customer' check (role in ('customer','admin')),
  address jsonb,
  profile jsonb not null default '{}'::jsonb,
  cart jsonb not null default '[]'::jsonb,
  created_at timestamptz not null default now()
);

create table if not exists public.products (
  id text primary key,
  name text not null,
  description text not null,
  price text not null,
  accent text,
  icon text
);

create table if not exists public.orders (
  id text primary key,
  user_id uuid references public.profiles(id) on delete cascade,
  username text not null,
  items jsonb not null,
  subtotal numeric not null,
  delivery_fee numeric not null default 0,
  bulk_fee_rate numeric not null default 0,
  bulk_fee numeric not null default 0,
  cod_fee numeric not null default 0,
  total numeric not null,
  payment_method text not null,
  address jsonb not null,
  placed_at bigint not null,
  delivery_days int not null,
  status_override int,
  cancelled boolean not null default false,
  rated jsonb not null default '{}'::jsonb
);

create table if not exists public.messages (
  id text primary key,
  name text not null,
  email text not null,
  message text not null,
  sent_at bigint not null
);

create table if not exists public.activity (
  id text primary key,
  type text not null,
  username text not null,
  at bigint not null
);

create table if not exists public.ratings (
  id bigserial primary key,
  product_id text not null,
  value int not null check (value between 1 and 5),
  created_at timestamptz not null default now()
);

-- ---------- Admin-check helper (avoids RLS recursion) ----------

create or replace function public.is_admin()
returns boolean
language sql
security definer
stable
as $$
  select exists(
    select 1 from public.profiles where id = auth.uid() and role = 'admin'
  );
$$;

-- ---------- Row Level Security ----------

alter table public.profiles enable row level security;
alter table public.products enable row level security;
alter table public.orders   enable row level security;
alter table public.messages enable row level security;
alter table public.activity enable row level security;
alter table public.ratings  enable row level security;

drop policy if exists "select own profile" on public.profiles;
create policy "select own profile" on public.profiles
  for select using (auth.uid() = id or is_admin());

drop policy if exists "insert own profile" on public.profiles;
create policy "insert own profile" on public.profiles
  for insert with check (auth.uid() = id);

drop policy if exists "update own profile" on public.profiles;
create policy "update own profile" on public.profiles
  for update using (auth.uid() = id or is_admin());

drop policy if exists "delete profile admin" on public.profiles;
create policy "delete profile admin" on public.profiles
  for delete using (is_admin());

drop policy if exists "products readable" on public.products;
create policy "products readable" on public.products
  for select using (auth.role() = 'authenticated');

drop policy if exists "products writable by admin" on public.products;
create policy "products writable by admin" on public.products
  for all using (is_admin()) with check (is_admin());

drop policy if exists "select own or admin orders" on public.orders;
create policy "select own or admin orders" on public.orders
  for select using (auth.uid() = user_id or is_admin());

drop policy if exists "insert own orders" on public.orders;
create policy "insert own orders" on public.orders
  for insert with check (auth.uid() = user_id);

drop policy if exists "update own or admin orders" on public.orders;
create policy "update own or admin orders" on public.orders
  for update using (auth.uid() = user_id or is_admin());

drop policy if exists "delete admin orders" on public.orders;
create policy "delete admin orders" on public.orders
  for delete using (is_admin());

drop policy if exists "insert messages authenticated" on public.messages;
create policy "insert messages authenticated" on public.messages
  for insert with check (auth.role() = 'authenticated');

drop policy if exists "select messages admin" on public.messages;
create policy "select messages admin" on public.messages
  for select using (is_admin());

drop policy if exists "delete messages admin" on public.messages;
create policy "delete messages admin" on public.messages
  for delete using (is_admin());

drop policy if exists "insert activity authenticated" on public.activity;
create policy "insert activity authenticated" on public.activity
  for insert with check (auth.role() = 'authenticated');

drop policy if exists "select activity admin" on public.activity;
create policy "select activity admin" on public.activity
  for select using (is_admin());

drop policy if exists "delete activity admin" on public.activity;
create policy "delete activity admin" on public.activity
  for delete using (is_admin());

drop policy if exists "insert ratings authenticated" on public.ratings;
create policy "insert ratings authenticated" on public.ratings
  for insert with check (auth.role() = 'authenticated');

drop policy if exists "select ratings public" on public.ratings;
create policy "select ratings public" on public.ratings
  for select using (true);

