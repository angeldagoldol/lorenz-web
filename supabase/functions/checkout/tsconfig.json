{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["contracts.ts", "errors.ts", "router.ts", "db.ts", "handler.ts"],
  "exclude": ["index.ts", "*.test.ts"]
}
